# ==============================================================================
# MACHII MENS MART — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env for local/staging/production use:
#    cp .env.example .env
# 2. Fill in your genuine credentials for live deployment.
# 3. NEVER commit the .env file to git or expose private keys in client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
STORE_URL=https://machiimensmart.com
CORS_ORIGIN=https://machiimensmart.com

# Authoritative Admin Access Key (Required for Admin Dashboard & API management)
# Generate a strong 32+ character random secret for production:
MACHII_ADMIN_KEY=your_strong_random_admin_secret_key_here

# Optional: Frontend API base URL if hosting frontend and backend on separate domains
# Leave blank or '/' when deploying frontend and backend together on the same origin:
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In-memory database with transactional file persistence is enabled by default.
# For high-concurrency cloud deployments, specify a PostgreSQL/MySQL connection string:
# DATABASE_URL=postgresql://machii_user:strong_password@localhost:5432/machii_production
# DB_MAX_CONNECTIONS=20
# DB_SSL=true

# ------------------------------------------------------------------------------
# 3. ONLINE PAYMENT GATEWAY (Razorpay)
# ------------------------------------------------------------------------------
# STEP A (Testing Phase): Start with Test Mode keys (prefixed with rzp_test_)
# STEP B (Live Launch): When KYC & verification are complete in the Razorpay
# dashboard, replace with your live keys (prefixed with rzp_live_).
# If omitted or left unconfigured, the store automatically and safely operates
# in Cash on Delivery (COD) mode with doorstep fulfillment instructions.
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
# Webhook secret configured in your Razorpay Dashboard -> Webhooks:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. CUSTOMER EMAIL NOTIFICATIONS (Choose Resend, SendGrid, or SMTP)
# ------------------------------------------------------------------------------
# Triggers order confirmation, payment receipts, and delivery updates.
# If unconfigured, notification audit records are safely logged with status
# 'NOT_CONFIGURED' without corrupting orders or claiming fake delivery.

# Option A: Resend (Recommended)
RESEND_API_KEY=re_123456789abcdef
RESEND_FROM_EMAIL="Machii Mens Mart <orders@machiimensmart.com>"

# Option B: SendGrid
# SENDGRID_API_KEY=SG.yourSendgridApiKeyHere
# SENDGRID_FROM_EMAIL=orders@machiimensmart.com

# Option C: Standard SMTP (Gmail, AWS SES, Mailgun, Postmark)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=orders@machiimensmart.com
# SMTP_PASS=your-smtp-app-password
# SMTP_FROM="Machii Mens Mart <orders@machiimensmart.com>"

# ------------------------------------------------------------------------------
# 5. CUSTOMER SMS & MOBILE NOTIFICATIONS (Choose Twilio or Fast2SMS)
# ------------------------------------------------------------------------------
# Triggers concise SMS updates for order dispatch, out for delivery, and delivery.

# Option A: Twilio SMS (Global & India)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Option B: Fast2SMS (India DLT Direct Route)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# ------------------------------------------------------------------------------
# 6. LOGGING & SECURITY
# ------------------------------------------------------------------------------
LOG_LEVEL=info
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
